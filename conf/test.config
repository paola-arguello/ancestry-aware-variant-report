// Small bundled dataset for CI and quick local runs.
// The test data are synthetic and live in tests/data/ (added in a later commit).

params {
    vcf              = "${projectDir}/tests/data/sample.vcf.gz"
    sample           = 'TEST'
    fasta            = "${projectDir}/tests/data/ref.fa"
    panel_bed        = "${projectDir}/tests/data/panel.bed"
    clinvar          = "${projectDir}/tests/data/clinvar.vcf.gz"
    gnomad           = "${projectDir}/tests/data/gnomad.vcf.gz"
    expected_contigs = "${projectDir}/tests/data/contigs.tsv"
    truth_vcf        = "${projectDir}/tests/data/truth.vcf.gz"
    truth_bed        = "${projectDir}/tests/data/truth.bed"
    outdir           = 'results-test'
}

// ancestry-aware-variant-report
// Synthetic data. Not for clinical use.

manifest {
    name            = 'ancestry-aware-variant-report'
    author          = 'Paola Arguello Pascualli'
    homePage        = 'https://github.com/paola-arguello/ancestry-aware-variant-report'
    description     = 'Germline small-variant report for a hereditary cancer panel, with ancestry-aware allele frequency checks'
    mainScript      = 'main.nf'
    nextflowVersion = '>=24.04.0'
    version         = '0.1.0dev'
}

params {
    // Sample
    vcf              = null
    sample           = null

    // Reference and resources (all GRCh38, UCSC-style contig names)
    fasta            = null
    panel_bed        = null
    clinvar          = null
    gnomad           = null
    expected_contigs = "${projectDir}/assets/grch38_contigs.tsv"

    // gnomAD genetic ancestry groups to carry into the report
    gnomad_groups    = 'afr,amr,asj,eas,fin,mid,nfe,sas,remaining'

    // Validation (optional)
    truth_vcf        = null
    truth_bed        = null

    outdir           = 'results'
}

profiles {
    docker {
        docker.enabled      = true
        process.container   = 'ancestry-aware-variant-report:0.1.0'
    }
    conda {
        conda.enabled       = true
        process.conda       = "${projectDir}/environment.yml"
    }
    test {
        includeConfig 'conf/test.config'
    }
}

process {
    cpus   = 1
    memory = '2 GB'
    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].toLowerCase()}" },
        mode: 'copy'
    ]
}

timeline {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/timeline.html"
}

report {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/report.html"
}
